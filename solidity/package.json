{
  "name": "gainix-solidity",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "clean": "hardhat clean",
    "test": "hardhat test",
    "deploy:bscTestnet": "hardhat run scripts/deploy.ts --network bscTestnet",
    "deploy:bscMainnet": "hardhat run scripts/deploy-mainnet.ts --network bscMainnet",
    "deploy:withdrawal:bscMainnet": "hardhat run scripts/deploy-withdrawal-vault-mainnet.ts --network bscMainnet",
    "verify:deployer:bscMainnet": "hardhat run scripts/verify-deployer.ts --network bscMainnet",
    "verify:contracts:bscMainnet": "hardhat run scripts/verify-contracts-mainnet.ts --network bscMainnet",
    "verify:withdrawal:bscMainnet": "hardhat run scripts/verify-withdrawal-vault-mainnet.ts --network bscMainnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "5.0.2",
    "dotenv": "^16.5.0",
    "hardhat": "^2.23.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
