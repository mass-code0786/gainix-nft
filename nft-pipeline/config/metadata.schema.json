{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gainix NFT Metadata",
  "type": "object",
  "required": ["name", "description", "image", "external_url", "edition", "dna", "family", "attributes", "gainix"],
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "image": { "type": "string" },
    "external_url": { "type": "string" },
    "edition": { "type": "integer", "minimum": 1 },
    "dna": { "type": "string" },
    "compiler": { "type": "string" },
    "date": { "type": "string" },
    "family": { "type": "string" },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trait_type", "value"],
        "properties": {
          "trait_type": { "type": "string" },
          "value": { "type": "string" },
          "rarity_tier": { "type": "string", "enum": ["common", "uncommon", "rare", "epic", "legendary"] },
          "weight": { "type": "number" },
          "asset": { "type": "string" }
        }
      }
    },
    "gainix": {
      "type": "object",
      "required": ["family", "layer_manifest"],
      "properties": {
        "family": {
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" }
          }
        },
        "layer_manifest": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "traitId", "traitName", "asset"],
            "properties": {
              "category": { "type": "string" },
              "traitId": { "type": "string" },
              "traitName": { "type": "string" },
              "asset": { "type": "string" },
              "rarity": { "type": "string", "enum": ["common", "uncommon", "rare", "epic", "legendary"] }
            }
          }
        }
      }
    }
  }
}
