# Production database
DATABASE_URL="postgresql://gainix_user:CHANGE_ME@127.0.0.1:5432/gainix_nft?schema=public"

# Local development only, if using prisma/schema.prisma
# DATABASE_URL="file:./dev.db"

# Server secrets
SESSION_SECRET="replace-with-a-long-random-secret"

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=replace-with-reown-walletconnect-project-id

# Data mode
NEXT_PUBLIC_USE_MOCK_DATA=false
MIN_WITHDRAWAL_AMOUNT=1
NEXT_PUBLIC_MIN_WITHDRAWAL_AMOUNT=1
ALLOW_MULTIPLE_WITHDRAWALS_PER_DAY=false
TEST_WITHDRAWAL_MODE=false
DAILY_WITHDRAWAL_LIMIT=3

# Chain and RPC endpoints
NEXT_PUBLIC_CHAIN_ID=56
NEXT_PUBLIC_BSC_MAINNET_RPC_URL=https://bsc-dataseed.binance.org
BSCSCAN_API_KEY=

# USDT BEP20 payments
